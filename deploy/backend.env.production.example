PORT=5000
HOST=127.0.0.1
NODE_ENV=production

MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/codesyncx?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_value
SESSION_SECRET=replace_with_a_long_random_value

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://codesyncx.ritik.online/login
CLIENT_ORIGIN=https://codesyncx.ritik.online
TRUST_PROXY_HOPS=1

REDIS_URL=redis://127.0.0.1:6379
SOCKET_REDIS_ADAPTER_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=true

EXECUTION_MODE=docker
EXECUTION_DOCKER_IMAGE=codesyncx-runner
EXECUTION_TIMEOUT_MS=5000
EXECUTION_OUTPUT_LIMIT_BYTES=20000
EXECUTION_WORKER_CONCURRENCY=2
EXECUTION_DOCKER_MEMORY=128m
EXECUTION_DOCKER_CPUS=0.5
EXECUTION_DOCKER_PIDS=64

RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_COMPILE_MAX=20
RATE_LIMIT_GITHUB_MAX=30
